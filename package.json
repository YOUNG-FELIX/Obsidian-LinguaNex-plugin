{
  "name": "lingua-nex",
  "version": "0.10.3",
  "description": "LinguaNex — 本地 MDX/MDD 词典查词与生词复习 Obsidian 插件",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
