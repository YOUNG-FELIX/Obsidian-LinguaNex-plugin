    "buffer": "^6.0.3",
    "builtin-modules": "^5.4.0",
    "esbuild": "^0.19.11",
    "obsidian": "latest",
    "process": "^0.11.10",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@babel/runtime": "^7.14.6",
    "@xmldom/xmldom": "^0.8.12",
    "doublearray": "0.0.2",
    "mdict-js": "^10.0.1",
    "pako": "^1.0.6"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.12"
  }
}
